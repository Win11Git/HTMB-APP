<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/htmb_dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTMB"
            android:textColor="@color/app_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="HIGH TRUST MANAGEMENT BANK"
            android:textColor="@color/app_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/receiptTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="32dp"
            android:text="Transaction Receipt"
            android:textColor="@color/app_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/receiptStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SUCCESSFUL"
            android:textColor="#16804A"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#808080" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Reference Number"
            android:textColor="@color/app_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/referenceNumberText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="HTMB-XXXXXXXX"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/amountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Amount"
            android:textColor="@color/app_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/amountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp"
            android:text="₱0.00"
            android:textColor="@color/app_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Account Name"
            android:textColor="@color/app_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/accountNumberText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Account Number"
            android:textColor="@color/app_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/recipientAccountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recipient Account"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/previousBalanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Previous Balance: ₱0.00"
            android:textColor="@color/app_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/newBalanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="New Balance: ₱0.00"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Date and Time"
            android:textColor="@color/app_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Keep this receipt for your records. This is a demo transaction, not proof of a real bank transaction."
            android:textColor="@color/app_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/app_primary"
            android:fontFamily="sans-serif-black"
            android:text="DONE"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
