<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="@drawable/htmb_dark_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- App Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTMB"
                android:textColor="@color/app_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Welcome -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Welcome!"
                android:textColor="@color/app_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Account Number -->
            <TextView
                android:id="@+id/accountNumberText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your Number: Not connected"
                android:textColor="@color/app_text"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Balance Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="117dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_rounded"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="AVAILABLE BALANCE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/balanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="₱0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="30sp"
                    android:autoSizeStepGranularity="1sp" />

            </LinearLayout>

            <!-- Banking Services -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Banking Services"
                android:textColor="@color/app_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Cash In -->
            <Button
                android:id="@+id/cashinButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:fontFamily="sans-serif-black"
                android:text="CASH-IN"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/app_primary" />

            <!-- Cash Out -->

            <!-- Transfer -->
            <Button
                android:id="@+id/cashoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/app_primary"
                android:minHeight="52dp"
                android:fontFamily="sans-serif-black"
                android:text="CASH-OUT"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/transferButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="TRANSFER"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/app_primary" />

            <!-- Transaction History -->
            <Button
                android:id="@+id/transactionHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="TRANSACTION HISTORY"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/app_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Logout -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="LOGOUT"
                android:textColor="#000000"
                android:backgroundTint="#D3D3D3" />


            <!-- Footer -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:text="High Trust Management Bank"
                android:textColor="@color/app_text"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
